# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://localhost:27017/agribook"

# Live Real-time Queue Layer (Redis)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="agribook_sih2026_jwt_secret_demo"
JWT_EXPIRES_IN="7d"

# Communication: Twilio SMS (Set MOCK_SMS=true for hackathon demo without billing)
MOCK_SMS=true
TWILIO_ACCOUNT_SID="AC_DEMO_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="DEMO_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+18005550199"

# Payment: Razorpay Prototype Simulation (Set MOCK_PAYMENTS=true for hackathon demo)
MOCK_PAYMENTS=true
RAZORPAY_KEY_ID="rzp_test_DEMO_KEY"
RAZORPAY_KEY_SECRET="DEMO_SECRET"

# Machine Learning: XGBoost Demand Forecasting Service
ML_SERVICE_URL="http://localhost:5000"

